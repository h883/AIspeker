# このファイルを .env にコピーして値を入れる（run.sh / run.ps1 が自動でコピーする）。
# .env は絶対に GitHub へ push しない（.gitignore 済み・仕様書 21章）。

# ===== 必須 =====
# https://aistudio.google.com/apikey で取得
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== 経路検索（任意。未設定でもアプリは起動する）=====
# Google Cloud で Routes API を有効にして取得したキー
GOOGLE_MAPS_API_KEY=

# ===== サーバー =====
HOST=0.0.0.0
PORT=8000
TZ_NAME=Asia/Tokyo
# 開発中にコード変更を自動反映したいときは 1
RELOAD=0

# ===== HTTPS（スマートフォンから音声入力を使うなら必須）=====
# ブラウザのマイクと PWA は https か localhost でしか動かない。
# python scripts/make_cert.py で証明書を作ってから下の2行を有効にする。
#SSL_CERT_FILE=config/cert.pem
#SSL_KEY_FILE=config/key.pem

# ===== プライバシー（仕様書 24章）=====
# マイク音声をサーバーに保存するか
SAVE_AUDIO=0
# 会話履歴を SQLite に保存するか
SAVE_HISTORY=1

# ===== 音声（既定はスマートフォンの Web Speech API）=====
# browser または gtts
TTS_PROVIDER=browser
# faster-whisper を入れた場合のモデルサイズ: tiny / base / small / medium
WHISPER_MODEL=small

# ===== Google カレンダー（任意）=====
# python scripts/google_auth.py で認証すると使えるようになる
GOOGLE_CALENDAR_ID=primary
